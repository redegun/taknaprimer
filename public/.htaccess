# task 446 (2026-10-22): PHP (api/*.php) работает на 8.3.36 через CGI (CVE-2026-109618). В панели Timeweb остаётся 7.2 — доступа к панели нет.
# Обёртка cgi-bin/php83.cgi лежит на хостинге вне git (CI без --delete её не трогает). Откат: удалить блок до '# task 446 END' (вернётся mod_php 7.2).
Action php83-cgi /cgi-bin/php83.cgi
AddHandler php83-cgi .php
# task 446 END

# taknaprimer.ru — статика Astro (format: directory)
Options -Indexes
AddDefaultCharset UTF-8
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  # закрыть дот-файлы, кроме .well-known
  RewriteRule "/\.|^\.(?!well-known/)" - [F]
</IfModule>

<IfModule mod_headers.c>
  # хэшированные ассеты сборки — навсегда
  <FilesMatch "\.(js|css|woff2|woff)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # картинки и видео кейсов/ленты — неделя
  <FilesMatch "\.(webp|jpg|jpeg|png|svg|mp4)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
  <FilesMatch "\.(html|json|xml|txt)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>
