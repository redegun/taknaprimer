---
import Layout from '@/layouts/Layout.astro';
import MerchForm from '@/components/MerchForm.astro';
import { u, uv } from '@/lib/url';
import { MERCH, MERCH_GROUPS } from '@/data/merch';
---
<Layout title="Вещи из кейсов — можно заказать" description="Худи, свитшоты, футболки, брошь из бисера, значки, стикеры и плакаты из кейсов Татьяны Кочневой («Так, например», taknaprimer). Каждую вещь можно заказать — цена индивидуальная.">
  <section class="py-12 sm:py-16">
    <div class="container-x">
      <div class="grid gap-6 lg:grid-cols-[1.2fr_1fr] lg:items-end" data-reveal>
        <div>
          <h1 class="text-4xl font-bold sm:text-6xl">Вещи из кейсов</h1>
          <p class="mt-5 max-w-2xl text-lg text-ink-2">Эти вещи появились в её кейсах: буквы на худи, значках, сумках и плакатах. Нас часто спрашивают, можно ли такое заказать. Можно — каждую вещь делаем под вас, от одной штуки.</p>
        </div>
        <div class="rounded-xl2 border border-line bg-white p-5 text-[15px] text-ink-2">
          <div class="font-display text-lg font-bold text-ink">Цена — индивидуально</div>
          <p class="mt-2">Она зависит от того, что и как делать: вышивка или принт, с одной стороны или с двух, материал, тираж. Выберите вещь и нажмите «Узнать цену» — посчитаем. А если хочется дешевле — встаньте в лист ожидания: напишем, когда соберём партию.</p>
          <p class="mt-2 text-muted">Картинки — визуализации из кейсов. Брошь «Ё» — настоящая, сделана руками.</p>
        </div>
      </div>

      <div class="mt-10 flex flex-wrap gap-2" id="merch-filters" data-reveal>
        <button class="chip is-on" data-filter="">Всё</button>
        {MERCH_GROUPS.map((g) => <button class="chip" data-filter={g}>{g}</button>)}
      </div>

      <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3" id="merch-grid">
        {MERCH.map((m) => (
          <article class="merch-card flex flex-col overflow-hidden rounded-xl2 bg-white ring-1 ring-ink/5" data-group={m.group} data-reveal>
            <a href={u(`/merch/${m.id}/`)} class="group relative block aspect-[4/5] overflow-hidden bg-paper-2">
              <img src={uv(m.images[0])} alt={m.title} loading="lazy" decoding="async" class="merch-main h-full w-full object-cover transition-transform duration-700 group-hover:scale-[1.03]" />
              {m.handmade && <span class="absolute left-3 top-3 rounded-full bg-accent px-3 py-1 text-xs font-semibold text-white">ручная работа</span>}
            </a>
            {m.images.length > 1 && (
              <div class="flex gap-2 px-4 pt-3">
                {m.images.map((src, i) => (
                  <button type="button" class:list={['merch-thumb h-12 w-12 overflow-hidden rounded-lg ring-2 transition', i === 0 ? 'ring-ink' : 'ring-transparent hover:ring-ink/30']} data-src={uv(src)} aria-label={`${m.title}, вариант ${i + 1}`}>
                    <img src={uv(src)} alt="" loading="lazy" class="h-full w-full object-cover" />
                  </button>
                ))}
              </div>
            )}
            <div class="flex flex-1 flex-col p-5">
              <div class="text-xs font-medium uppercase tracking-wide text-muted">{m.collection}</div>
              <h2 class="mt-1.5 text-xl font-bold leading-tight"><a href={u(`/merch/${m.id}/`)} class="hover:text-accent">{m.title}</a></h2>
              <p class="mt-2 text-[15px] text-ink-2">{m.text}</p>
              <div class="mt-3 flex flex-wrap gap-1.5">
                {m.options.map((o) => <span class="rounded-full bg-paper-2 px-2.5 py-1 text-xs font-medium text-ink-2">{o}</span>)}
              </div>
              <div class="mt-auto flex flex-wrap items-center justify-between gap-3 pt-5">
                <span class="font-display text-[15px] font-bold">цена индивидуально</span>
                <div class="flex items-center gap-3">
                  <a href={u(`/merch/${m.id}/#wait`)} class="text-sm text-muted underline decoration-line underline-offset-4 hover:text-accent">ждать партию</a>
                  <a href="#zakaz" class="btn btn-primary !py-2.5 text-sm" data-order={m.title}>Узнать цену</a>
                </div>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="py-12 sm:py-16" id="zakaz">
    <div class="container-x"><MerchForm /></div>
  </section>

  <script>
    // фильтр по группам
    const chips = document.querySelectorAll<HTMLButtonElement>('#merch-filters .chip');
    const cards = document.querySelectorAll<HTMLElement>('#merch-grid .merch-card');
    chips.forEach((chip) => chip.addEventListener('click', () => {
      chips.forEach((c) => c.classList.toggle('is-on', c === chip));
      const f = chip.dataset.filter || '';
      cards.forEach((c) => c.classList.toggle('hidden', !!f && c.dataset.group !== f));
    }));
    // миниатюры: переключают главную картинку карточки
    document.querySelectorAll<HTMLButtonElement>('.merch-thumb').forEach((t) => t.addEventListener('click', () => {
      const card = t.closest('.merch-card')!;
      card.querySelector<HTMLImageElement>('.merch-main')!.src = t.dataset.src!;
      card.querySelectorAll('.merch-thumb').forEach((x) => { x.classList.toggle('ring-ink', x === t); x.classList.toggle('ring-transparent', x !== t); });
    }));
    // «Узнать цену» подставляет вещь в форму
    const select = document.querySelector<HTMLSelectElement>('.merch-form [name=item]')!;
    document.querySelectorAll<HTMLAnchorElement>('[data-order]').forEach((a) => a.addEventListener('click', () => { select.value = a.dataset.order!; }));
  </script>
</Layout>
