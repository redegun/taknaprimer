---
import Layout from '@/layouts/Layout.astro';
import ProjectForm from '@/components/ProjectForm.astro';
import { SITE } from '@/lib/url';
---
<Layout title="Контакты" description="Обсудить проект с Татьяной Кочневой, «Так, например» (taknaprimer): леттеринг, айдентика, буквы-объекты, текстиль, печать. Telegram @taknaprimer, почта taknaprimer@yandex.ru.">
  <section class="py-12 sm:py-16">
    <div class="container-x">
      <div class="grid gap-8 lg:grid-cols-[1.3fr_1fr] lg:items-end" data-reveal>
        <div>
          <h1 class="text-4xl font-bold sm:text-6xl">Обсудить проект</h1>
          <p class="mt-5 max-w-2xl text-lg text-muted">Соберите запрос из наклеек: перетащите нужные в заявку — как я собираю буквы. Отвечу так, например, завтра.</p>
        </div>
        <dl class="grid grid-cols-3 gap-4 lg:gap-6">
          <div><dt class="text-xs font-semibold uppercase tracking-wide text-muted">Telegram</dt><dd><a class="font-medium underline decoration-line underline-offset-4 hover:text-accent" href={SITE.tg} target="_blank" rel="noopener">@taknaprimer</a></dd></div>
          <div><dt class="text-xs font-semibold uppercase tracking-wide text-muted">Почта</dt><dd><a class="break-all font-medium underline decoration-line underline-offset-4 hover:text-accent" href={`mailto:${SITE.email}`}>{SITE.email}</a></dd></div>
          <div><dt class="text-xs font-semibold uppercase tracking-wide text-muted">Канал</dt><dd><a class="font-medium underline decoration-line underline-offset-4 hover:text-accent" href={SITE.channel} target="_blank" rel="noopener">t.me/tak_naprimer</a></dd></div>
        </dl>
      </div>
      {/* форма во всю ширину контейнера: слева лист наклеек, справа заявка */}
      <div class="mt-8 rounded-xl2 border border-line bg-white p-6 sm:p-8" id="forma">
        <ProjectForm />
      </div>
    </div>
  </section>
</Layout>
