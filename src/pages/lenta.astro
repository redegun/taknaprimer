---
import Layout from '@/layouts/Layout.astro';
import { SITE } from '@/lib/url';
import { cardHTML, type LentaPost } from '@/lib/lenta-client';
import feed from '@/data/lenta.json';
const posts = feed as LentaPost[];
const html = posts.map((p) => cardHTML(p, 'grid')).join('');
---
<Layout title="Лента" description="Последние посты из Telegram-канала «Так, например»: буквы, процесс, челленджи." noindex>
  <section class="py-12 sm:py-16">
    <div class="container-x">
      <div class="flex flex-wrap items-end justify-between gap-4" data-reveal>
        <div>
          <h1 class="text-4xl font-bold sm:text-6xl">Лента</h1>
          <p class="mt-4 max-w-2xl text-lg text-muted">Посты из канала «Так, например». Самое свежее — сверху, всё остальное — в самом канале.</p>
        </div>
        <a href={SITE.channel} target="_blank" rel="noopener" class="btn btn-primary">Подписаться</a>
      </div>
      <div class="mt-10 columns-1 gap-5 sm:columns-2 lg:columns-3 [&>*]:mb-5 [&>*]:break-inside-avoid" data-lenta-track data-first={posts[0]?.id ?? 0} data-reveal set:html={html} />
    </div>
  </section>
  <script>
    import { refreshLenta } from '@/lib/lenta-client';
    refreshLenta(document.querySelector<HTMLElement>('[data-lenta-track]'), 'grid');
  </script>
</Layout>
