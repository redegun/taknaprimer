---
import '@/styles/global.css';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import { u, SITE } from '@/lib/url';
import { imageSize, publicPath } from '@/lib/imgsize';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  noindex?: boolean;
  ogType?: 'website' | 'article';
  // доп. узлы JSON-LD страницы (кейс, пост): image подставляется сам — та же картинка, что og:image
  schema?: Record<string, unknown>;
  stickyHeader?: boolean;
  theme?: 'light' | 'dark';
  // карточка og:image 1200×630 (#5106): название (по умолчанию H1), раздел, фото (по умолчанию ogImage), оффер со страницы
  social?: { title?: string; label?: string; photos?: string[]; offer?: string };
}
const { theme = 'light', title, description = 'Так, например (taknaprimer) — сайт дизайнера Татьяны Кочневой: леттеринг, шрифтовые алфавиты, айдентика, буквы-объекты из бумаги, скотча и ткани.', ogImage, noindex = false, stickyHeader = true, ogType = 'website', schema, social } = Astro.props;
// Бренд в каждом title: кириллицей и слитно латиницей — по нему ищут
const fullTitle = title === SITE.name ? `Так, например (taknaprimer) — ${SITE.person}, дизайнер: леттеринг и айдентика` : `${title} — Так, например · taknaprimer`;
const isPreview = import.meta.env.BASE_URL !== '/';
const canonical = new URL(Astro.url.pathname, Astro.site).toString();
const og = ogImage ? new URL(ogImage, Astro.site).toString() : new URL(u('/og.jpg'), Astro.site).toString();
// реальные размеры og-картинки (Discover/соцсети: крупное превью от 1200 px)
const ogSize = await imageSize(og);
const pageNode = schema
  ? { ...schema, url: canonical, mainEntityOfPage: canonical, image: { '@type': 'ImageObject', url: og, ...(ogSize ? { width: ogSize[0], height: ogSize[1] } : {}) } }
  : null;
// og:image рисует scripts/social-images.mjs после сборки по этим данным и подменяет meta og:image/twitter:image.
// JSON-LD остаётся с фото страницы. Кейс или пост со своим фото от 1200 px (узел JSON-LD, ветка Discover #2122) —
// раскладка photo: работа целиком без заголовка. Превью и noindex — без карточки.
const discoverPhoto = !!(schema && ogImage && ogSize && ogSize[0] >= 1200);
const socialMeta = (noindex || isPreview) ? null : JSON.stringify({
  m: discoverPhoto ? 'photo' : 'card',
  t: social?.title, l: social?.label, o: social?.offer,
  p: (discoverPhoto ? [og] : social?.photos ?? (ogImage ? [ogImage] : [])).map(publicPath),
});
const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'WebSite', '@id': 'https://taknaprimer.ru/#website', url: 'https://taknaprimer.ru/', name: 'Так, например', alternateName: ['taknaprimer', 'Так например', 'taknaprimer.ru'], inLanguage: 'ru-RU', publisher: { '@id': 'https://taknaprimer.ru/#person' } },
    { '@type': 'Person', '@id': 'https://taknaprimer.ru/#person', name: 'Татьяна Кочнева', alternateName: 'Так, например', jobTitle: 'Дизайнер', url: 'https://taknaprimer.ru/obo-mne/', image: 'https://taknaprimer.ru/about/tanya.webp', sameAs: [SITE.channel, 'https://www.behance.net/tak_naprimer'], knowsAbout: ['леттеринг', 'каллиграфия', 'шрифтовые алфавиты', 'айдентика', 'буквы-объекты'] },
    ...(pageNode ? [pageNode] : []),
  ],
});
---
<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {(noindex || isPreview)
      ? <meta name="robots" content="noindex, nofollow" />
      : <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={u('/favicon.svg')} type="image/svg+xml" />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={og} />
    {ogSize && <meta property="og:image:width" content={String(ogSize[0])} />}
    {ogSize && <meta property="og:image:height" content={String(ogSize[1])} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={og} />
    <meta property="og:locale" content="ru_RU" />
    <meta property="og:site_name" content="Так, например (taknaprimer)" />
    {socialMeta && <meta name="tn-social" content={socialMeta} />}
    <script type="application/ld+json" set:html={jsonLd} />
    <meta name="theme-color" content={theme === 'dark' ? '#1e1e1e' : '#faf8f3'} />
    <script is:inline>document.documentElement.classList.add('js');</script>
    {!isPreview && (
      <>
        {/* Яндекс.Метрика, счётчик 113665438 — официальный сниппет (?id= в URL, иначе код не проходит автопроверку) */}
        <script is:inline>
          (function(m,e,t,r,i,k,a){m[i]=m[i]||function(){(m[i].a=m[i].a||[]).push(arguments)};m[i].l=1*new Date();for(var j=0;j<document.scripts.length;j++){if(document.scripts[j].src===r){return;}}k=e.createElement(t),a=e.getElementsByTagName(t)[0],k.async=1,k.src=r,a.parentNode.insertBefore(k,a)})(window,document,"script","https://mc.yandex.ru/metrika/tag.js?id=113665438","ym");
          ym(113665438,"init",{ssr:true,webvisor:true,clickmap:true,referrer:document.referrer,url:location.href,accurateTrackBounce:true,trackLinks:true});
        </script>
        <noscript><div><img src="https://mc.yandex.ru/watch/113665438" style="position:absolute;left:-9999px" alt="" /></div></noscript>
      </>
    )}
  </head>
  <body class:list={['min-h-screen flex flex-col', theme === 'dark' && 'theme-dark']}>
    <Header sticky={stickyHeader} />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
    <script>
      // появление блоков при скролле
      const els = document.querySelectorAll('[data-reveal]');
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver((entries) => {
          for (const e of entries) {
            if (e.isIntersecting) { e.target.classList.add('is-in'); io.unobserve(e.target); }
          }
        }, { rootMargin: '0px 0px -8% 0px', threshold: 0.08 });
        els.forEach((el) => io.observe(el));
      } else {
        els.forEach((el) => el.classList.add('is-in'));
      }
    </script>
  </body>
</html>
