---
import '@/styles/global.css';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import { u, SITE } from '@/lib/url';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  noindex?: boolean;
  stickyHeader?: boolean;
  theme?: 'light' | 'dark';
}
const { theme = 'light', title, description = 'Так, например (taknaprimer) — сайт дизайнера Татьяны Кочневой: леттеринг, шрифтовые алфавиты, айдентика, буквы-объекты из бумаги, скотча и ткани.', ogImage, noindex = false, stickyHeader = true } = Astro.props;
// Бренд в каждом title: кириллицей и слитно латиницей — по нему ищут
const fullTitle = title === SITE.name ? `Так, например (taknaprimer) — ${SITE.person}, дизайнер: леттеринг и айдентика` : `${title} — Так, например · taknaprimer`;
const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'WebSite', '@id': 'https://taknaprimer.ru/#website', url: 'https://taknaprimer.ru/', name: 'Так, например', alternateName: ['taknaprimer', 'Так например', 'taknaprimer.ru'], inLanguage: 'ru-RU', publisher: { '@id': 'https://taknaprimer.ru/#person' } },
    { '@type': 'Person', '@id': 'https://taknaprimer.ru/#person', name: 'Татьяна Кочнева', alternateName: 'Так, например', jobTitle: 'Дизайнер', url: 'https://taknaprimer.ru/obo-mne/', image: 'https://taknaprimer.ru/about/tanya.webp', sameAs: [SITE.channel, 'https://www.behance.net/tak_naprimer'], knowsAbout: ['леттеринг', 'каллиграфия', 'шрифтовые алфавиты', 'айдентика', 'буквы-объекты'] },
  ],
});
const isPreview = import.meta.env.BASE_URL !== '/';
const canonical = new URL(Astro.url.pathname, Astro.site).toString();
const og = ogImage ? new URL(ogImage, Astro.site).toString() : new URL(u('/og.jpg'), Astro.site).toString();
---
<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {(noindex || isPreview) && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={u('/favicon.svg')} type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={og} />
    <meta property="og:locale" content="ru_RU" />
    <meta property="og:site_name" content="Так, например (taknaprimer)" />
    <script type="application/ld+json" set:html={jsonLd} />
    <meta name="theme-color" content={theme === 'dark' ? '#1e1e1e' : '#faf8f3'} />
    <script is:inline>document.documentElement.classList.add('js');</script>
    {!isPreview && (
      <>
        {/* Яндекс.Метрика, счётчик 113665438 — официальный сниппет (?id= в URL, иначе код не проходит автопроверку) */}
        <script is:inline>
          (function(m,e,t,r,i,k,a){m[i]=m[i]||function(){(m[i].a=m[i].a||[]).push(arguments)};m[i].l=1*new Date();for(var j=0;j<document.scripts.length;j++){if(document.scripts[j].src===r){return;}}k=e.createElement(t),a=e.getElementsByTagName(t)[0],k.async=1,k.src=r,a.parentNode.insertBefore(k,a)})(window,document,"script","https://mc.yandex.ru/metrika/tag.js?id=113665438","ym");
          ym(113665438,"init",{ssr:true,webvisor:true,clickmap:true,referrer:document.referrer,url:location.href,accurateTrackBounce:true,trackLinks:true});
        </script>
        <noscript><div><img src="https://mc.yandex.ru/watch/113665438" style="position:absolute;left:-9999px" alt="" /></div></noscript>
      </>
    )}
  </head>
  <body class:list={['min-h-screen flex flex-col', theme === 'dark' && 'theme-dark']}>
    <Header sticky={stickyHeader} />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
    <script>
      // появление блоков при скролле
      const els = document.querySelectorAll('[data-reveal]');
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver((entries) => {
          for (const e of entries) {
            if (e.isIntersecting) { e.target.classList.add('is-in'); io.unobserve(e.target); }
          }
        }, { rootMargin: '0px 0px -8% 0px', threshold: 0.08 });
        els.forEach((el) => io.observe(el));
      } else {
        els.forEach((el) => el.classList.add('is-in'));
      }
    </script>
  </body>
</html>
