---
import { u } from '@/lib/url';
import type { CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'cases'>;
  big?: boolean;
}
const { entry, big = false } = Astro.props;
const d = entry.data;
---
<a href={u(`/raboty/${entry.id}/`)} class="card group" data-tags={d.tags.join('|')} data-reveal>
  <div class:list={['overflow-hidden bg-paper-2', big ? 'aspect-[4/3]' : 'aspect-square']}>
    <img src={u(d.cover)} alt={d.coverAlt ?? d.title} loading="lazy" decoding="async" class="h-full w-full object-cover" />
  </div>
  <div class="p-5">
    <div class="flex items-baseline justify-between gap-3">
      <h3 class:list={['font-display font-bold leading-tight group-hover:text-accent transition-colors', big ? 'text-2xl' : 'text-lg']}>{d.title}</h3>
      <span class="shrink-0 text-sm text-muted">{d.year} <span class="like-count-badge hidden items-center gap-1 pl-2" data-like-count={entry.id}><svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 21s-7-4.6-9.3-8.6C.9 9.2 2.4 5.5 6 5.5c2 0 3.2 1.1 4 2.3.8-1.2 2-2.3 4-2.3 3.6 0 5.1 3.7 3.3 6.9C19 16.4 12 21 12 21z"/></svg><span></span></span></span>
    </div>
    <p class="mt-2 text-[15px] text-muted line-clamp-2">{d.short}</p>
    <div class="mt-3 flex flex-wrap gap-1.5">
      {d.tags.slice(0, 3).map((t) => <span class="rounded-full bg-paper-2 px-2.5 py-1 text-xs font-medium text-ink-2">{t}</span>)}
    </div>
  </div>
</a>
<script>
  // счётчики лайков на карточках (один запрос на страницу)
  const badges = document.querySelectorAll<HTMLElement>('[data-like-count]');
  if (badges.length && !(window as any).__likesLoaded) {
    (window as any).__likesLoaded = true;
    const base = (document.querySelector('a.card[href]') as HTMLAnchorElement | null)?.getAttribute('href')?.replace(/\/raboty\/.*$/, '') ?? '';
    fetch(`${base}/api/like.php?all=1`, { cache: 'no-store' }).then((r) => r.json()).then((d) => {
      badges.forEach((b) => { const n = d.counts?.[b.dataset.likeCount!]; if (n) { b.querySelector('span')!.textContent = String(n); b.classList.remove('hidden'); b.classList.add('inline-flex'); } });
    }).catch(() => {});
  }
</script>
