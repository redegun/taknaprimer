---
import { u } from '@/lib/url';
import { fmtDate, postTitle, postUrl, type LentaEntry } from '@/lib/lenta';

interface Props {
  entry: LentaEntry;
  mode?: 'carousel' | 'grid';
}
const { entry, mode = 'grid' } = Astro.props;
const d = entry.data;
const cover = d.photos[0] ?? d.videos[0]?.poster ?? '';
const isVideo = !d.photos.length && d.videos.length > 0;
const counts = [d.photos.length > 1 ? `${d.photos.length} фото` : '', d.videos.length ? `${d.videos.length} видео` : ''].filter(Boolean).join(' · ');
const meta = `${fmtDate(d.date, mode === 'grid')}${counts ? ' · ' + counts : ''}`;
---
<a href={u(postUrl(entry))} class:list={['card', mode === 'carousel' ? 'snap-start w-[78vw] shrink-0 sm:w-[340px]' : '']}>
  <div class:list={['relative overflow-hidden bg-paper-2', mode === 'carousel' ? 'aspect-square' : '']}>
    {cover ? (
      <img src={u(cover)} alt={postTitle(entry)} loading="lazy" decoding="async" class:list={[mode === 'carousel' ? 'h-full w-full object-cover' : 'w-full']} />
    ) : (
      <div class="flex aspect-square items-center justify-center font-display text-5xl text-muted">Т,</div>
    )}
    {d.videos.length > 0 && (
      <span class="absolute left-3 top-3 inline-flex items-center gap-1 rounded-full bg-ink/80 px-2.5 py-1 text-xs font-semibold text-paper backdrop-blur">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5v14l11-7z"/></svg>{isVideo ? 'видео' : `+${d.videos.length} видео`}
      </span>
    )}
  </div>
  <div class="p-4">
    <div class="text-xs font-medium uppercase tracking-wide text-muted">{meta}</div>
    <p class:list={['mt-1.5 text-[15px] leading-snug text-ink-2', mode === 'carousel' ? 'line-clamp-3' : 'whitespace-pre-line line-clamp-6']}>{d.text || postTitle(entry)}</p>
  </div>
</a>
