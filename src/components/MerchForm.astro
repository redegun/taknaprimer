---
// Форма «Узнать цену» для мерча: шлёт в общий /api/form.php, текст заявки собирается в message.
import { u, SITE } from '@/lib/url';
import { MERCH } from '@/data/merch';
interface Props { selected?: string; title?: string }
const { selected = '', title = 'Узнать цену' } = Astro.props;
---
<div class="rounded-xl2 border border-line bg-white p-6 sm:p-8">
  <h2 class="text-3xl font-bold sm:text-4xl">{title}</h2>
  <p class="mt-2 text-muted">Напишите, что хочется, — пришлём варианты и стоимость. Или сразу в Telegram: <a class="font-medium text-ink underline decoration-line underline-offset-4 hover:text-accent" href={SITE.tg} target="_blank" rel="noopener">@taknaprimer</a>.</p>
  <form class="merch-form mt-6 grid gap-5 sm:grid-cols-2" action={u('/api/form.php')} method="post" novalidate>
    <input type="text" name="website" tabindex="-1" autocomplete="off" class="hidden" aria-hidden="true" />
    <input type="hidden" name="started" value="" />
    <input type="hidden" name="what[]" value="мерч" />
    <input type="hidden" name="message" value="" />
    <label class="block">
      <span class="mb-2 block font-display text-lg font-bold">Что заказать</span>
      <select name="item" class="w-full rounded-full border border-line bg-white px-5 py-3 text-[16px] outline-none focus:border-ink">
        <option value="">выберите вещь</option>
        {MERCH.map((m) => <option value={m.title} selected={m.title === selected}>{m.title}</option>)}
        <option value="другое">другое / несколько вещей</option>
      </select>
    </label>
    <label class="block">
      <span class="mb-2 block font-display text-lg font-bold">Сколько штук</span>
      <input type="text" name="qty" placeholder="например, 1 или 30 на команду" class="w-full rounded-full border border-line bg-white px-5 py-3 text-[16px] outline-none focus:border-ink" />
    </label>
    <label class="block sm:col-span-2">
      <span class="mb-2 block font-display text-lg font-bold">Детали</span>
      <textarea name="details" rows="4" placeholder="цвет, размер, буква или слово, к какому сроку" class="w-full rounded-xl2 border border-line bg-white px-4 py-3 text-[16px] outline-none focus:border-ink"></textarea>
    </label>
    <label class="block sm:col-span-2">
      <span class="mb-2 block font-display text-lg font-bold">Как с вами связаться</span>
      <input type="text" name="contact" required placeholder="@telegram или почта" class="w-full rounded-full border border-line bg-white px-5 py-3 text-[16px] outline-none focus:border-ink" />
    </label>
    <div class="sm:col-span-2 flex flex-wrap items-center gap-4">
      <button type="submit" class="btn btn-accent">Отправить запрос</button>
      <p class="form-status hidden text-[15px]" role="status" aria-live="polite"></p>
    </div>
  </form>
</div>

<script>
  document.querySelectorAll<HTMLFormElement>('.merch-form').forEach((form) => {
    (form.querySelector('[name=started]') as HTMLInputElement).value = String(Date.now());
    const status = form.querySelector<HTMLElement>('.form-status')!;
    const btn = form.querySelector<HTMLButtonElement>('button[type=submit]')!;
    const v = (n: string) => ((form.querySelector(`[name="${n}"]`) as HTMLInputElement | null)?.value || '').trim();
    const fail = (msg: string) => { status.textContent = msg; btn.disabled = false; btn.textContent = 'Отправить запрос'; };
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      status.classList.remove('hidden');
      if (!v('contact') || (!v('item') && !v('details'))) { status.textContent = 'Выберите вещь или опишите, что хочется, и оставьте контакт.'; return; }
      (form.querySelector('[name=message]') as HTMLInputElement).value =
        `Мерч: ${v('item') || 'не выбрано'}\nКоличество: ${v('qty') || '—'}\n${v('details')}`.trim();
      btn.disabled = true; btn.textContent = 'Отправляю…';
      try {
        const res = await fetch(form.action, { method: 'POST', body: new FormData(form), headers: { Accept: 'application/json' } });
        const data = await res.json().catch(() => ({}));
        if (res.ok && data.ok) {
          form.querySelectorAll('label, button').forEach((el) => el.classList.add('hidden'));
          status.innerHTML = '<span class="font-display text-lg font-bold">Спасибо!</span> Получила запрос, отвечу с вариантами и ценой.';
        } else fail(data.error || 'Не отправилось. Напишите в Telegram: @taknaprimer');
      } catch { fail('Не отправилось. Напишите в Telegram: @taknaprimer'); }
    });
  });
</script>
