---
import { u, SITE } from '@/lib/url';
import { cardHTML, type LentaPost } from '@/lib/lenta-client';
import feed from '@/data/lenta.json';

interface Props {
  limit?: number;
  title?: string;
}
const { limit = 12, title = 'Из канала' } = Astro.props;
const posts = (feed as LentaPost[]).slice(0, limit);
const html = posts.map((p) => cardHTML(p, 'carousel')).join('');
---
<section class="py-16 sm:py-24" id="lenta" data-limit={limit}>
  <div class="container-x">
    <div class="flex flex-wrap items-end justify-between gap-4" data-reveal>
      <div>
        <h2 class="text-3xl font-bold sm:text-4xl">{title}</h2>
        <p class="mt-2 text-muted">Свежее из Telegram-канала «Так, например»: процесс, буквы, челленджи.</p>
      </div>
      <div class="flex items-center gap-2">
        <a href={SITE.channel} target="_blank" rel="noopener" class="btn btn-ghost !py-2">Подписаться</a>
        <button class="lenta-prev rounded-full border border-ink/20 p-2.5 hover:bg-ink hover:text-paper" aria-label="Назад">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 6l-6 6 6 6"/></svg>
        </button>
        <button class="lenta-next rounded-full border border-ink/20 p-2.5 hover:bg-ink hover:text-paper" aria-label="Вперёд">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 6l6 6-6 6"/></svg>
        </button>
      </div>
    </div>

    <div class="lenta-track no-scrollbar mt-8 flex snap-x snap-mandatory gap-4 overflow-x-auto pb-2 [scroll-padding-inline:1rem]" data-lenta-track data-first={posts[0]?.id ?? 0} data-reveal set:html={html} />
    <div class="mt-6">
      <a href={u('/lenta/')} class="font-medium underline decoration-line underline-offset-4 hover:text-accent">Вся лента →</a>
    </div>
  </div>
  <script>
    import { refreshLenta } from '@/lib/lenta-client';
    document.querySelectorAll<HTMLElement>('#lenta').forEach((root) => {
      const track = root.querySelector<HTMLElement>('[data-lenta-track]');
      const step = () => (track?.firstElementChild as HTMLElement | null)?.offsetWidth ?? 320;
      root.querySelector('.lenta-prev')?.addEventListener('click', () => track?.scrollBy({ left: -step() - 16, behavior: 'smooth' }));
      root.querySelector('.lenta-next')?.addEventListener('click', () => track?.scrollBy({ left: step() + 16, behavior: 'smooth' }));
      refreshLenta(track, 'carousel', Number(root.dataset.limit || 12));
    });
  </script>
</section>
