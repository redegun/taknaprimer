---
// Кнопка «Оценить» с сердечком и счётчиком. Счётчик — public/api/like.php; состояние «уже оценил» — localStorage + отпечаток на сервере.
// variant: 'pill' — обычная кнопка с подписью; 'round' — круглая иконка со счётчиком-бейджем (для плавающей панели).
import { u } from '@/lib/url';

interface Props {
  slug: string;
  size?: 'md' | 'lg';
  label?: boolean;
  variant?: 'pill' | 'round';
}
const { slug, size = 'md', label = true, variant = 'pill' } = Astro.props;
const heart = '<path d="M12 21s-7-4.6-9.3-8.6C.9 9.2 2.4 5.5 6 5.5c2 0 3.2 1.1 4 2.3.8-1.2 2-2.3 4-2.3 3.6 0 5.1 3.7 3.3 6.9C19 16.4 12 21 12 21z"/>';
---
{variant === 'round' ? (
  <button type="button" class="like-btn like-btn--round relative grid h-11 w-11 place-items-center rounded-full border border-ink/10 bg-white text-ink shadow-[0_2px_10px_rgba(0,0,0,0.08)] transition-colors hover:border-accent hover:text-accent" data-like={slug} data-api={u('/api/like.php')} aria-pressed="false" title="Оценить">
    <svg class="like-icon h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" set:html={heart} />
    <span class="like-count absolute -right-1 -top-1 min-w-[18px] rounded-full bg-ink px-1 text-center text-[10px] font-bold leading-[18px] text-paper">·</span>
  </button>
) : (
  <button type="button" class:list={['like-btn group inline-flex items-center gap-2 rounded-full border border-ink/15 bg-white font-semibold text-ink transition-colors hover:border-accent hover:text-accent', size === 'lg' ? 'px-5 py-3 text-[15px]' : 'px-3.5 py-2 text-sm']} data-like={slug} data-api={u('/api/like.php')} aria-pressed="false" title="Оценить">
    <svg class="like-icon h-[1.15em] w-[1.15em] transition-transform group-active:scale-90" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" set:html={heart} />
    {label && <span class="like-label">Оценить</span>}
    <span class="like-count tabular-nums text-muted">·</span>
  </button>
)}

<script>
  const api = (document.querySelector<HTMLElement>('[data-like]')?.dataset.api) ?? '/api/like.php';
  const btns = [...document.querySelectorAll<HTMLButtonElement>('[data-like]')];
  const slugs = [...new Set(btns.map((b) => b.dataset.like!))];
  const paint = (slug: string, count: number, liked: boolean) => {
    btns.filter((b) => b.dataset.like === slug).forEach((b) => {
      b.querySelector('.like-count')!.textContent = String(count);
      b.setAttribute('aria-pressed', String(liked));
      b.classList.toggle('is-liked', liked);
      const l = b.querySelector('.like-label'); if (l) l.textContent = liked ? 'Спасибо!' : 'Оценить';
    });
    document.querySelectorAll<HTMLElement>(`[data-like-label="${slug}"]`).forEach((el) => (el.textContent = liked ? 'Спасибо!' : 'Оценить'));
  };
  const key = (s: string) => `liked:${s}`;
  const paintViews = (slug: string, views: number) => {
    document.querySelectorAll<HTMLElement>(`[data-views="${slug}"]`).forEach((el) => { el.textContent = String(views); const w = el.closest('[data-views-wrap]'); w?.classList.remove('hidden'); w?.classList.add('inline-flex'); });
  };
  slugs.forEach(async (slug) => {
    let liked = false; try { liked = localStorage.getItem(key(slug)) === '1'; } catch {}
    try {
      // просмотр: раз за сессию с этой вкладки, сервер дополнительно режет до раза в сутки с устройства
      let seen = false; try { seen = sessionStorage.getItem(`viewed:${slug}`) === '1'; } catch {}
      let d: any;
      if (!seen) {
        const fd = new FormData(); fd.set('slug', slug); fd.set('action', 'view');
        d = await (await fetch(api, { method: 'POST', body: fd })).json();
        try { sessionStorage.setItem(`viewed:${slug}`, '1'); } catch {}
      } else {
        d = await (await fetch(`${api}?slug=${encodeURIComponent(slug)}`, { cache: 'no-store' })).json();
      }
      paint(slug, d.count ?? 0, liked || !!d.liked);
      paintViews(slug, d.views ?? 0);
    } catch { paint(slug, 0, liked); }
  });
  btns.forEach((b) => b.addEventListener('click', async () => {
    const slug = b.dataset.like!;
    if (b.getAttribute('aria-pressed') === 'true') return;
    const cur = Number(b.querySelector('.like-count')!.textContent) || 0;
    paint(slug, cur + 1, true);
    try { localStorage.setItem(key(slug), '1'); } catch {}
    try {
      const fd = new FormData(); fd.set('slug', slug);
      const r = await fetch(api, { method: 'POST', body: fd });
      const d = await r.json();
      if (d.ok) paint(slug, d.count, true);
    } catch {}
  }));
</script>

<style>
  .like-btn.is-liked { border-color: var(--color-accent); color: var(--color-accent); }
  .like-btn.is-liked .like-icon { fill: currentColor; animation: like-pop 0.45s cubic-bezier(0.2, 0.8, 0.2, 1); }
  .like-btn--round.is-liked { background: var(--color-accent); color: #fff; border-color: var(--color-accent); }
  .like-btn--round.is-liked .like-count { background: #fff; color: var(--color-accent); }
  @keyframes like-pop { 0% { transform: scale(0.6); } 60% { transform: scale(1.3); } 100% { transform: scale(1); } }
</style>
