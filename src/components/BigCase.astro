---
// Большой кейс на главной: анимированная обложка (первый GIF презентации с Behance, иначе первая картинка/обложка) + текст.
import { u } from '@/lib/url';
import type { CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'cases'>;
  flip?: boolean;
}
const { entry, flip = false } = Astro.props;
const d = entry.data;
const imgs = d.presentation.flatMap((b) => (b.kind === 'image' ? [{ src: b.src!, w: b.w, h: b.h }] : b.kind === 'grid' ? (b.items ?? []) : []));
const hero = imgs.find((i) => /\.gif$/i.test(i.src)) ?? imgs[0] ?? { src: d.cover, w: undefined, h: undefined };
const ratio = hero.w && hero.h ? `${hero.w}/${hero.h}` : '4/3';
const bg = d.presentationStyle?.bg ?? '#f1ede4';
---
<a href={u(`/raboty/${entry.id}/`)} class="group grid items-center gap-6 lg:grid-cols-[1.25fr_1fr] lg:gap-12" data-reveal>
  <figure class:list={['overflow-hidden rounded-xl2', flip ? 'lg:order-2' : '']} style={`background:${bg}`}>
    <img src={u(hero.src)} alt={d.title} width={hero.w} height={hero.h} loading="lazy" decoding="async" class="block w-full object-cover transition-transform duration-700 group-hover:scale-[1.02]" style={`aspect-ratio:${ratio};max-height:680px`} />
  </figure>
  <div class:list={[flip ? 'lg:order-1' : '']}>
    <div class="flex flex-wrap items-center gap-2 text-sm text-muted">
      <span>{d.period ?? d.year}</span>
      {d.tags.slice(0, 3).map((t) => <span class="rounded-full bg-paper-2 px-2.5 py-1 text-xs font-medium text-ink-2">{t}</span>)}
    </div>
    <h3 class="mt-3 text-3xl font-bold leading-[1.05] transition-colors group-hover:text-accent sm:text-5xl">{d.title}</h3>
    <p class="mt-4 max-w-xl text-lg text-ink-2">{d.short}</p>
    {d.result && <p class="mt-3 text-[15px] text-muted">{d.result}</p>}
    <div class="mt-6 flex flex-wrap items-center gap-4">
      <span class="btn btn-primary">Смотреть кейс</span>
      <span class="like-count-badge hidden items-center gap-1 text-sm text-muted" data-like-count={entry.id}><svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 21s-7-4.6-9.3-8.6C.9 9.2 2.4 5.5 6 5.5c2 0 3.2 1.1 4 2.3.8-1.2 2-2.3 4-2.3 3.6 0 5.1 3.7 3.3 6.9C19 16.4 12 21 12 21z"/></svg><span></span></span>
    </div>
  </div>
</a>
