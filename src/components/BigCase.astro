---
// Большой кейс на главной. Форматы (frontmatter home.layout):
//  wide  — полотно во всю ширину экрана на фоне проекта (анимированный GIF-коллаж), подпись под ним;
//  band  — тёмная полоса во всю ширину: текст слева, доска справа;
//  split — в контейнере: картинка + текст (по умолчанию).
import { u } from '@/lib/url';
import type { CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'cases'>;
  flip?: boolean;
}
const { entry, flip = false } = Astro.props;
const d = entry.data;
const href = u(`/raboty/${entry.id}/`);
const imgs = d.presentation.flatMap((b) => (b.kind === 'image' ? [{ src: b.src!, w: b.w, h: b.h }] : b.kind === 'grid' ? (b.items ?? []) : []));
const auto = imgs.find((i) => /\.gif$/i.test(i.src)) ?? imgs[0] ?? { src: d.cover, w: undefined, h: undefined };
const media = d.home?.media ?? auto.src;
const meta = imgs.find((i) => i.src === media);
const ratio = meta?.w && meta?.h ? `${meta.w}/${meta.h}` : undefined;
const layout = d.home?.layout ?? 'split';
const bg = d.home?.bg ?? d.presentationStyle?.bg ?? '#f1ede4';
const dark = !!d.home?.dark;
const heart = '<path d="M12 21s-7-4.6-9.3-8.6C.9 9.2 2.4 5.5 6 5.5c2 0 3.2 1.1 4 2.3.8-1.2 2-2.3 4-2.3 3.6 0 5.1 3.7 3.3 6.9C19 16.4 12 21 12 21z"/>';
---
{layout === 'wide' ? (
  <section class="py-6 sm:py-10" data-reveal>
    <a href={href} class="group block" style={`background:${bg}`}>
      <div class="mx-auto max-w-[1600px]">
        <img src={u(media)} alt={d.title} width={meta?.w} height={meta?.h} loading="lazy" decoding="async" class="block w-full" style={ratio ? `aspect-ratio:${ratio}` : undefined} />
      </div>
    </a>
    <div class="container-x mt-6 grid gap-4 sm:mt-8 lg:grid-cols-[1.1fr_1fr] lg:items-end">
      <a href={href} class="group">
        <div class="text-sm text-muted">{d.period ?? d.year} · {d.tags.slice(0, 3).join(' · ')}</div>
        <h3 class="mt-2 text-4xl font-bold leading-[1] transition-colors group-hover:text-accent sm:text-6xl lg:text-7xl">{d.title}</h3>
      </a>
      <div>
        <p class="max-w-xl text-lg text-ink-2">{d.short}</p>
        <div class="mt-4 flex flex-wrap items-center gap-4">
          <a href={href} class="btn btn-primary">Смотреть кейс</a>
          <span class="like-count-badge hidden items-center gap-1 text-sm text-muted" data-like-count={entry.id}><svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" set:html={heart} /><span></span></span>
        </div>
      </div>
    </div>
  </section>
) : layout === 'band' ? (
  <section class:list={['py-14 sm:py-20', dark ? 'text-paper' : 'text-ink']} style={`background:${bg}`} data-reveal>
    <div class="container-x grid items-center gap-10 lg:grid-cols-[1fr_1.2fr] lg:gap-16">
      <div class:list={[flip ? 'lg:order-2' : '']}>
        <div class:list={['text-sm', dark ? 'text-paper/60' : 'text-muted']}>{d.period ?? d.year} · {d.tags.slice(0, 3).join(' · ')}</div>
        <a href={href} class="group block"><h3 class="mt-3 text-4xl font-bold leading-[1.02] transition-colors group-hover:text-accent sm:text-6xl">{d.title}</h3></a>
        <p class:list={['mt-5 max-w-xl text-lg', dark ? 'text-paper/80' : 'text-ink-2']}>{d.short}</p>
        <div class="mt-7 flex flex-wrap items-center gap-4">
          <a href={href} class:list={['btn', dark ? 'bg-paper text-ink hover:bg-accent hover:text-white' : 'btn-primary']}>Смотреть кейс</a>
          <span class:list={['like-count-badge hidden items-center gap-1 text-sm', dark ? 'text-paper/60' : 'text-muted']} data-like-count={entry.id}><svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" set:html={heart} /><span></span></span>
        </div>
      </div>
      <a href={href} class:list={['group block overflow-hidden rounded-xl2 bg-white', flip ? 'lg:order-1' : '']}>
        <img src={u(media)} alt={d.title} width={meta?.w} height={meta?.h} loading="lazy" decoding="async" class="block w-full transition-transform duration-700 group-hover:scale-[1.02]" style={ratio ? `aspect-ratio:${ratio}` : undefined} />
      </a>
    </div>
  </section>
) : (
  <section class="py-6 sm:py-10" data-reveal>
    <a href={href} class="container-x group grid items-center gap-6 lg:grid-cols-[1fr_1fr] lg:gap-12">
      <figure class:list={['overflow-hidden rounded-xl2', flip ? 'lg:order-2' : '']} style={`background:${bg}`}>
        <img src={u(media)} alt={d.title} width={meta?.w} height={meta?.h} loading="lazy" decoding="async" class="block w-full object-cover transition-transform duration-700 group-hover:scale-[1.02]" style={`${ratio ? `aspect-ratio:${ratio};` : ''}max-height:640px`} />
      </figure>
      <div class:list={[flip ? 'lg:order-1' : '']}>
        <div class="text-sm text-muted">{d.period ?? d.year} · {d.tags.slice(0, 3).join(' · ')}</div>
        <h3 class="mt-3 text-3xl font-bold leading-[1.05] transition-colors group-hover:text-accent sm:text-5xl">{d.title}</h3>
        <p class="mt-4 max-w-xl text-lg text-ink-2">{d.short}</p>
        {d.result && <p class="mt-3 text-[15px] text-muted">{d.result}</p>}
        <div class="mt-6 flex flex-wrap items-center gap-4">
          <span class="btn btn-primary">Смотреть кейс</span>
          <span class="like-count-badge hidden items-center gap-1 text-sm text-muted" data-like-count={entry.id}><svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" set:html={heart} /><span></span></span>
        </div>
      </div>
    </a>
  </section>
)}
